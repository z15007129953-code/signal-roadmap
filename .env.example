# Copy to .env.local for Next.js; supply LOCAL_POSTGRES_PASSWORD to Docker Compose.
# Replace every placeholder. Generate three independent secrets of at least 32 characters.
NODE_ENV=development
APP_URL=http://localhost:3000
LOCAL_POSTGRES_PASSWORD=<generate-a-local-only-password>
DATABASE_URL=postgresql://signal_local:<url-encoded-local-password>@127.0.0.1:54329/signal
TEST_DATABASE_URL=postgresql://signal_local:<url-encoded-local-password>@127.0.0.1:54330/signal_test
AUTH_SECRET=<generate-auth-secret>
DEMO_COOKIE_SECRET=<generate-demo-cookie-secret>
CRON_SECRET=<generate-cron-secret>

# Development without SMTP prints short-lived sign-in links in the local server console.
# Production requires BOTH values. EMAIL_FROM must be a plain email address.
# EMAIL_SERVER accepts smtp:// or smtps:// URLs; URL-encode credentials.
EMAIL_SERVER=
EMAIL_FROM=

# Optional logo storage: supply the complete group when enabling uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Required in production. Missing or unavailable Redis blocks public API requests.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
